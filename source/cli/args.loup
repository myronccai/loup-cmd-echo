@mode(host.dual)

# Command-line parsing for echo. GNU echo is unusual: it accepts only the
# single-letter options n, e and E (combinable, as in `-ne`), stops at the
# first argument that is not such an option, and treats `--` as an ordinary
# operand. `--help` and `--version` are recognised only as the sole argument.
#
# Runtime: host.dual. Compiled into the native binary build/echo by `make
# build`; `loup run source/main.loup` interprets the same code.

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub newline: bool;
    pub escapes: bool;
    pub operands: list[string];
}

# Whether `arg` is an echo option: a dash followed only by n, e and E.
pub func is_echo_option(arg: string): bool {
    if (arg.len() < 2 or !arg.startsWith("-")) {
        return false;
    }
    for (ch in arg.slice(1)) {
        if (ch != "n" and ch != "e" and ch != "E") {
            return false;
        }
    }
    return true;
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    if (argv.len() == 1) {
        help = argv[0] == "--help";
        version = argv[0] == "--version";
    }

    var newline = true;
    var escapes = false;
    var i = 0;
    while (i < argv.len() and is_echo_option(argv[i])) {
        for (ch in argv[i].slice(1)) {
            if (ch == "n") {
                newline = false;
            } else if (ch == "e") {
                escapes = true;
            } else {
                escapes = false;
            }
        }
        i += 1;
    }

    return Ok(Options(
        help = help,
        version = version,
        newline = newline,
        escapes = escapes,
        operands = argv.slice(i),
    ));
}
