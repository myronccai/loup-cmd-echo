@mode(host.dual)

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        i"usage: {$ APP_NAME $} [SHORT-OPTION]... [STRING]...",
        i"  or:  {$ APP_NAME $} LONG-OPTION",
        "",
        "Echo the STRING(s) to standard output, separated by single spaces.",
        "",
        "  -n             do not output the trailing newline",
        "  -e             enable interpretation of backslash escapes",
        "  -E             disable interpretation of backslash escapes (default)",
        "      --help     display this help and exit",
        "      --version  output version information and exit",
        "",
        "If -e is in effect, the following sequences are recognized:",
        "",
        "  \\\\      backslash",
        "  \\a      alert (BEL)",
        "  \\b      backspace",
        "  \\c      produce no further output",
        "  \\e      escape",
        "  \\f      form feed",
        "  \\n      new line",
        "  \\r      carriage return",
        "  \\t      horizontal tab",
        "  \\v      vertical tab",
        "  \\0NNN   character with octal value NNN (1 to 3 digits)",
        "  \\xHH    character with hexadecimal value HH (1 to 2 digits)",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
