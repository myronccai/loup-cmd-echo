@mode(host.dual)

# Application identity for echo: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/echo by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "echo";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Write arguments to standard output (a Loup recreation of GNU echo).";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
