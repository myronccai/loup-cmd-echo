@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, is_echo_option);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(opts.newline and !opts.escapes, "defaults");
    expect(!opts.help and !opts.version, "no help or version");
}

func test_option_letters(): void {
    expect(is_echo_option("-n"), "-n");
    expect(is_echo_option("-neE"), "-neE");
    expect(!is_echo_option("-"), "lone dash");
    expect(!is_echo_option("--"), "double dash");
    expect(!is_echo_option("-nx"), "unknown letter");
    expect(!is_echo_option("n"), "no dash");
}

func test_combined_options(): void {
    let opts = parse_args(["-ne", "a"]).unwrap();
    expect(!opts.newline, "-n");
    expect(opts.escapes, "-e");
    expectEq(opts.operands[0], "a", "operand");
}

func test_last_escape_option_wins(): void {
    expect(!parse_args(["-e", "-E", "x"]).unwrap().escapes, "-e -E");
    expect(parse_args(["-E", "-e", "x"]).unwrap().escapes, "-E -e");
}

func test_options_stop_at_first_operand(): void {
    let opts = parse_args(["a", "-n"]).unwrap();
    expect(opts.newline, "-n after an operand is an operand");
    expectEq(opts.operands.len(), 2, "two operands");
    expectEq(opts.operands[1], "-n", "literal -n");
}

func test_double_dash_is_an_operand(): void {
    let opts = parse_args(["--", "-n"]).unwrap();
    expectEq(opts.operands[0], "--", "-- is printed");
    expect(opts.newline, "-n after -- is an operand");
}

func test_help_and_version_only_alone(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["--help", "x"]).unwrap().help, "--help with another argument");
    expect(!parse_args(["x", "--version"]).unwrap().version, "--version after an operand");
}
